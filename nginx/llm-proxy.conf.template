# Generated from nginx/llm-proxy.conf.template by: uv run llm config apply
# Do not edit this file directly - edit the template and re-run config apply.

upstream llm_chat  { server 127.0.0.1:%%SERVER_PORT%%; }
upstream llm_embed { server 127.0.0.1:%%EMBED_PORT%%;  }

server {
    listen %%PROXY_PORT%% ssl;
    server_name %%LAN_IP%%;

    # Self-signed cert - generate with:
    #   sudo mkdir -p /etc/ssl/local-llm
    #   sudo openssl req -x509 -newkey rsa:4096 -keyout /etc/ssl/local-llm/key.pem \
    #       -out /etc/ssl/local-llm/cert.pem -days 3650 -nodes \
    #       -subj "/CN=local-llm"
    ssl_certificate     /etc/ssl/local-llm/cert.pem;
    ssl_certificate_key /etc/ssl/local-llm/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # Only allow requests from the LAN subnet and LXD containers
    allow %%LAN_SUBNET%%;
%%LXD_ALLOW_LINE%%    deny  all;

    # Long timeouts for LLM inference (1 hour)
    proxy_read_timeout    3600s;
    proxy_send_timeout    3600s;
    proxy_connect_timeout 10s;
    keepalive_timeout     3600s;

    # Embedding requests → embedding server
    location /v1/embeddings {
        if ($http_authorization != "Bearer %%API_KEY%%") {
            return 401 '{"error":"Unauthorized","message":"Valid Bearer token required"}';
        }

        proxy_pass         http://llm_embed;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_buffering    off;
        proxy_cache        off;
    }

    # All other requests → chat server
    location / {
        # Require Bearer token - reject anything that doesn't match exactly
        if ($http_authorization != "Bearer %%API_KEY%%") {
            return 401 '{"error":"Unauthorized","message":"Valid Bearer token required"}';
        }

        proxy_pass         http://llm_chat;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;

        # Required for streaming (SSE) responses
        proxy_buffering    off;
        proxy_cache        off;
        chunked_transfer_encoding on;
    }
}
