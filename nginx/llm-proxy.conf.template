# Generated from nginx/llm-proxy.conf.template by: uv run llm config apply
# Do not edit this file directly — edit the template and re-run config apply.

# Map the Authorization header to a boolean: 1 if it matches our key, 0 otherwise.
map $http_authorization $auth_valid {
    default                    0;
    "Bearer %%API_KEY%%"       1;
}

server {
    listen %%LAN_IP%%:%%PROXY_PORT%% ssl;
    server_name %%LAN_IP%%;

    # Self-signed cert — generate with:
    #   sudo mkdir -p /etc/ssl/local-llm
    #   sudo openssl req -x509 -newkey rsa:4096 -keyout /etc/ssl/local-llm/key.pem \
    #       -out /etc/ssl/local-llm/cert.pem -days 3650 -nodes \
    #       -subj "/CN=local-llm"
    ssl_certificate     /etc/ssl/local-llm/cert.pem;
    ssl_certificate_key /etc/ssl/local-llm/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # Only allow requests from the local subnet
    allow %%LAN_SUBNET%%;
    deny  all;

    # Long timeouts for LLM inference
    proxy_read_timeout  600s;
    proxy_send_timeout  600s;
    proxy_connect_timeout 10s;

    location / {
        if ($auth_valid = 0) {
            return 401 '{"error":"Unauthorized","message":"Valid Bearer token required"}';
        }

        proxy_pass         http://127.0.0.1:%%SERVER_PORT%%;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;

        # Required for streaming (SSE) responses
        proxy_buffering    off;
        proxy_cache        off;
        chunked_transfer_encoding on;
    }
}
